{
  "name": "ledgerhall",
  "private": true,
  "version": "1.0.0",
  "description": "Ledgerhall — the banking operating system of the Exchequer of Aldermoor (fictional, demo-only).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "vite build --mode embed",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:audit": "node scripts/functional-audit.mjs",
    "snapshot": "vite-node scripts/build-snapshot.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-armenian": "5.3.0",
    "@fontsource/noto-serif-armenian": "5.3.0",
    "@fontsource/pinyon-script": "5.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fake-indexeddb": "6.2.5",
    "html-to-image": "1.11.13",
    "jsbarcode": "3.12.3",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "lucide-react": "1.50.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
